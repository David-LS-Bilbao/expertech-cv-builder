# ═══════════════════════════════════════════════════════════
# EXPERTECH CV — Backend API environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file with real secrets.
# ═══════════════════════════════════════════════════════════

# ─── Development (local) ────────────────────────────────────

# Port the backend listens on.
PORT=3002

# Comma-separated list of allowed CORS origins.
# In local dev this is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string.
# In local dev: Docker container (port 5435 to avoid collisions).
DATABASE_URL=postgresql://expertech:devpassword@localhost:5435/expertech_cv_dev?schema=public

# Jooble API key for job search proxy.
# Without a real key the endpoint returns mock data.
JOOBLE_API_KEY=YOUR_REAL_KEY_HERE

# bcrypt rounds for password hashing. Default 10.
# Higher = stronger but slower. Recommended 12 in production.
BCRYPT_ROUNDS=10

# ─── Production (example values — replace all) ──────────────
#
# PORT=3002
#
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
# (Use the internal URL provided by Railway/Render/Fly.io, not a public one)
#
# JOOBLE_API_KEY=your-real-jooble-api-key
#
# BCRYPT_ROUNDS=12
#
# NODE_ENV=production
