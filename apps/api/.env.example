# Puerto en el que escucha el backend (default 3002 para no chocar con el legacy en 3001)
PORT=3002

# Origenes permitidos por CORS (separados por coma). Default: dev de Vite.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API key de Jooble para /jobs/search.
# Si falta, el endpoint degrada a mock.
JOOBLE_API_KEY=YOUR_REAL_KEY_HERE

# Conexión a PostgreSQL.
# Por defecto apunta al contenedor Docker definido en docker-compose.yml
# (puerto 5435 en host para no chocar con otras instancias locales).
DATABASE_URL=postgresql://expertech:devpassword@localhost:5435/expertech_cv_dev?schema=public
